; Ember & Ash — Godot 4.3 project (GL Compatibility renderer for broad Windows support)
config_version=5

[application]

config/name="Ember & Ash"
config/description="A straight top-down fantasy blacksmith RPG and village-life simulation."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.08, 0.05, 0.03, 1)
boot_splash/show_image=false

[autoload]

Log="*res://scripts/autoload/log.gd"
Events="*res://scripts/autoload/events.gd"
Settings="*res://scripts/autoload/settings.gd"
Assets="*res://scripts/autoload/assets.gd"
Audio="*res://scripts/autoload/audio.gd"
DB="*res://scripts/autoload/db.gd"
Game="*res://scripts/autoload/game.gd"
Saves="*res://scripts/autoload/saves.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.08, 0.05, 0.03, 1)

[physics]

2d/default_gravity=0.0
