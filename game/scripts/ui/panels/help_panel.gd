## HelpPanel — the searchable reference guide and encyclopedia (content from Reference + Guide) and the tutorial switch.
## EN: args {"topic": tab id | search phrase | "item:<def>" | "recipe:<id>" | "station:<id>" | "knowledge",
##     "back": {route, args}} opens a section, a search or an encyclopedia page. Pages are generated by Guide:
##     at a glance (state badge), "show me how" (the next step with a button), then full details (every
##     source, what it is made from and used in, the dependency tree). Links move between pages; Back returns.
##     Nothing the smith has not discovered is listed.
## DA: Den søgbare opslagsbog og encyklopædi; args {"topic": ...} åbner et afsnit eller en side.
class_name HelpPanel
extends UIWindow

var tab := "basics"
var query := ""
var page := ""              # an encyclopedia topic shown instead of the list ("" = the list)
var history: Array = []     # previous places: {"page", "tab", "query"}
var back_action: Dictionary = {}
var search: LineEdit
var tab_col: VBoxContainer
var list: VBoxContainer
var scroller: ScrollContainer
var count_label: Label
var tut_button: Button


func _init(args: Dictionary = {}) -> void:
	super._init("Help & Reference", 1440, 800)   # #47: was 1500×860
	back_action = args.get("back", {})
	var t := str(args.get("topic", ""))
	if t == "":
		return
	var is_tab := false
	for x in Reference.TABS:
		if x[0] == t:
			is_tab = true
	if is_tab:
		tab = t
	elif t.contains(":"):
		if Reference.topic_visible(t):
			page = t
			tab = _tab_of(t)
		else:
			query = ""
	else:
		query = t


static func _tab_of(topic: String) -> String:
	if topic.begins_with("item:"):
		return "materials"
	if topic.begins_with("recipe:"):
		return "recipes"
	if topic.begins_with("station:"):
		return "stations"
	return "knowledge"


func _ready() -> void:
	super._ready()
	var top := UIKit.hbox(12)
	top.add_child(UIKit.label("Search", 24, "heading"))
	search = LineEdit.new()
	search.placeholder_text = "Type to search every section — e.g. anvil, rarity, raw hide"
	search.custom_minimum_size = Vector2(620, UIKit.BUTTON_H)
	search.add_theme_font_override("font", Assets.font("body"))
	search.add_theme_font_size_override("font_size", 22)
	search.text = query
	search.clear_button_enabled = true
	search.text_changed.connect(func(t: String):
		query = t
		page = ""
		_fill())
	top.add_child(search)
	count_label = UIKit.label("", 18, "body_italic")
	count_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	top.add_child(count_label)
	tut_button = UIKit.button("", _toggle_tutorial, 0)
	top.add_child(tut_button)
	content.add_child(top)
	var h := UIKit.hbox(16)
	tab_col = UIKit.vbox(4)
	tab_col.custom_minimum_size = Vector2(330, 0)
	h.add_child(tab_col)
	list = UIKit.vbox(10)
	scroller = UIKit.scroll(list, 660)
	scroller.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	h.add_child(scroller)
	content.add_child(h)
	_tabs()
	_fill()
	_tut_label()
	if query == "" and page == "":
		search.call_deferred("grab_focus")


func _tut_label() -> void:
	tut_button.text = "Hide the tutorial" if Tutorial.enabled() else "Restart the tutorial"


func _toggle_tutorial() -> void:
	if Tutorial.enabled():
		Tutorial.set_enabled(false)
		Events.toast.emit("Tutorial hidden.", "info")
	else:
		Tutorial.restart()
		Events.toast.emit("Tutorial restarted — see the card on the left.", "good")
	_tut_label()


func _tabs() -> void:
	UIKit.clear(tab_col)
	for t in Reference.TABS:
		var key: String = t[0]
		var b := UIKit.button(t[1], func():
			history.clear()
			tab = key
			query = ""
			page = ""
			search.text = ""
			_tabs()
			_fill(), 0)
		b.alignment = HORIZONTAL_ALIGNMENT_LEFT
		if key == tab and query == "":
			b.add_theme_color_override("font_color", UIKit.RUBRIC)
			b.add_theme_color_override("font_hover_color", UIKit.RUBRIC)
			b.text = "❧ " + str(t[1])
		tab_col.add_child(b)


# ------------------------------------------------------------------ navigation
## Follows a link from a page or a list: encyclopedia topics open here (with Back); others leave the panel.
func _on_meta(meta: String) -> void:
	var page_link := meta.begins_with("item:") or meta.begins_with("recipe:") or meta.begins_with("station:")
	if meta == "knowledge" or (page_link and Reference.topic_visible(meta)):
		open_topic(meta)
	elif meta.begins_with("item:") or meta.begins_with("recipe:"):
		Events.toast.emit("You know too little about that yet.", "info")
	else:
		GuideUI.follow(meta)


func open_topic(topic: String) -> void:
	history.append({"page": page, "tab": tab, "query": query})
	if topic == "knowledge":
		page = ""
		tab = "knowledge"
		query = ""
	else:
		page = topic
		tab = _tab_of(topic)
	_fill()


func _back() -> void:
	if history.is_empty():
		return
	var h: Dictionary = history.pop_back()
	page = str(h["page"])
	tab = str(h["tab"])
	query = str(h["query"])
	if search.text != query:
		search.set_block_signals(true)
		search.text = query
		search.set_block_signals(false)
	_fill()


func _nav_bar() -> Control:
	var h := UIKit.hbox(10)
	if not history.is_empty():
		h.add_child(UIKit.button("← Back", _back, 0))
	if not back_action.is_empty():
		var cap := "Return to " + Guide.the_station(str(back_action.get("args", {}).get("id", ""))) if str(back_action.get("route", "")) == "station" else "Return"
		h.add_child(UIKit.button(cap, func(): Events.open_panel.emit(str(back_action["route"]), back_action.get("args", {})), 0))
	return h


# ------------------------------------------------------------------ list
func _fill() -> void:
	UIKit.clear(list)
	scroller.scroll_vertical = 0
	if page != "":
		count_label.text = Reference.tab_name(tab) + " › page"
		list.add_child(_nav_bar())
		_page(page)
		_tabs()
		return
	var es: Array
	if query.strip_edges() != "":
		es = Reference.search(query)
		count_label.text = "%d result%s for “%s”" % [es.size(), "" if es.size() == 1 else "s", query.strip_edges()]
	else:
		es = Reference.tab_entries(tab)
		count_label.text = Reference.tab_name(tab)
		if not history.is_empty() or not back_action.is_empty():
			list.add_child(_nav_bar())
		list.add_child(UIKit.label(Reference.tab_name(tab), 32, "title"))
		if tab in ["materials", "recipes", "stations"]:
			list.add_child(UIKit.label("Click a name for its page: where to get it, how to make it, and what to do next.", 19, "body_italic"))
	if es.is_empty():
		list.add_child(UIKit.label("Nothing found. Try another word — undiscovered Designs and secrets are not listed.", 22, "body_italic"))
		return
	var last_tab := ""
	for e in es:
		if query.strip_edges() != "" and e["tab"] != last_tab:
			last_tab = e["tab"]
			list.add_child(UIKit.label(Reference.tab_name(last_tab), 24, "heading", UIKit.RUBRIC))
		var row := UIKit.hbox(14)
		if str(e.get("icon", "")) != "" and Assets.has_tex(str(e["icon"])):
			row.add_child(UIKit.icon(str(e["icon"]), 56))
		else:
			var sp := Control.new()
			sp.custom_minimum_size = Vector2(56, 10)
			row.add_child(sp)
		var v := UIKit.vbox(2)
		v.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		var topic := str(e.get("topic", ""))
		if topic != "" and topic != "knowledge":
			var th := UIKit.hbox(10)
			var tl := GuideUI.rich_links("[font_size=24]%s[/font_size]" % GuideUI.link(topic, str(e["title"])), 22, _on_meta)
			tl.add_theme_font_override("normal_font", Assets.font("heading"))
			tl.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			th.add_child(tl)
			if topic.begins_with("recipe:") and not Game.state.is_empty():
				var rs := Guide.recipe_status(topic.substr(7))
				th.add_child(GuideUI.badge(str(rs["state"]), GuideUI.recipe_badge_text(rs), 26))
			v.add_child(th)
		else:
			v.add_child(UIKit.label(str(e["title"]), 24, "heading"))
		v.add_child(UIKit.rich(str(e["body"]), 19))
		row.add_child(v)
		list.add_child(row)
		list.add_child(UIKit.divider())
	_tabs()


# ------------------------------------------------------------------ pages
func _page(topic: String) -> void:
	if topic.begins_with("item:"):
		_item_page(topic.substr(5))
	elif topic.begins_with("recipe:"):
		_recipe_page(topic.substr(7))
	elif topic.begins_with("station:"):
		_station_page(topic.substr(8))


func _heading(text: String) -> Label:
	return UIKit.label(text, 25, "heading", UIKit.RUBRIC)


func _head_row(icon: String, title: String, sub: String, badge: Control) -> Control:
	var row := UIKit.hbox(16)
	row.add_child(UIKit.icon(icon, 84))
	var v := UIKit.vbox(2)
	v.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	v.add_child(UIKit.label(title, 34, "title"))
	if sub != "":
		v.add_child(UIKit.label(sub, 19, "body_italic", Color(0.37, 0.26, 0.11)))
	row.add_child(v)
	if badge != null:
		badge.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		row.add_child(badge)
	return row


func _item_page(def: String) -> void:
	var d := DB.item(def)
	var have := Game.count(def)
	var st := Guide.status(def, maxi(1, have))
	list.add_child(_head_row("icons/" + str(d.get("icon", def)), str(d.get("name", def)),
		"%s · value %d g · you have %d" % [Items.type_label({"def": def}), int(d.get("value", 0)), have],
		GuideUI.badge(st, "In your stores (%d)" % have if st == "have" else "", 30)))
	if str(d.get("desc", "")) != "":
		list.add_child(UIKit.rich("[i]%s[/i]" % str(d["desc"]), 20))
	# show me how
	list.add_child(_heading("Show me how" if have == 0 else "To get more"))
	list.add_child(GuideUI.next_step_box("item:" + def, _on_meta, {}, Guide.how_to_get(def, have + 1)))
	# ways to get it
	list.add_child(_heading("Where to get it"))
	list.add_child(GuideUI.sources_block(def, _on_meta, 4))
	var makers := Guide.recipes_making(def)
	if not makers.is_empty():
		list.add_child(_heading("How it is made"))
		var lines := []
		for r in makers:
			var rs := Guide.recipe_status(str(r["id"]))
			var ins := []
			for k in r.get("inputs", {}):
				ins.append("%d× %s" % [int(r["inputs"][k]), GuideUI.item_link(str(k))])
			var sts := []
			for s in r.get("steps", []):
				var sl := GuideUI.link("station:" + str(s), Guide.the_station(str(s)))
				if not sts.has(sl):
					sts.append(sl)
			lines.append("%s %s — from %s at %s%s" % [GuideUI.glyph(str(rs["state"])), GuideUI.recipe_link(str(r["id"])), ", ".join(ins), " → ".join(sts),
				(" (makes %d)" % int(r.get("qty", 1))) if int(r.get("qty", 1)) > 1 else ""])
		list.add_child(GuideUI.rich_links("\n".join(lines), 19, _on_meta))
	var uses := Guide.recipes_using(def)
	if not uses.is_empty():
		list.add_child(_heading("Used in (%d)" % uses.size()))
		# what the smith can make soonest first; the long tail of locked recipes behind a toggle
		var order := {"ready": 0, "missing": 1, "locked": 2}
		var ranked := []
		for r in uses:
			var stt := str(Guide.recipe_status(str(r["id"]))["state"])
			ranked.append({"st": stt, "rank": int(order.get(stt, 3)), "name": str(r.get("name", "")),
				"txt": "%s %s" % [GuideUI.glyph(stt), GuideUI.recipe_link(str(r["id"]))]})
		ranked.sort_custom(func(a, b): return a["name"] < b["name"] if a["rank"] == b["rank"] else a["rank"] < b["rank"])
		var near := ranked.filter(func(x): return x["st"] != "locked")
		var far := ranked.filter(func(x): return x["st"] == "locked")
		if not near.is_empty():
			list.add_child(GuideUI.rich_links("   ".join(near.map(func(x): return x["txt"])), 19, _on_meta))
		if not far.is_empty():
			var far_txt := "   ".join(far.map(func(x): return x["txt"]))
			if near.is_empty() and far.size() <= 6:
				list.add_child(GuideUI.rich_links(far_txt, 19, _on_meta))
			else:
				list.add_child(GuideUI.expander("%d more you cannot make yet" % far.size(), func(body: VBoxContainer):
					body.add_child(GuideUI.rich_links(far_txt, 19, _on_meta))))
	if not makers.is_empty():
		list.add_child(GuideUI.expander("Full details: everything it depends on", func(body: VBoxContainer):
			body.add_child(UIKit.label("Each line: ✓ ready · ◷ obtainable / missing · ✗ locked. Intermediate materials are made from the lines beneath them.", 17, "body_italic"))
			body.add_child(GuideUI.tree_block("item:" + def, _on_meta))))


func _recipe_page(rid: String) -> void:
	var r := DB.recipe(rid)
	var out := str(r.get("output", ""))
	var rs := Guide.recipe_status(rid)
	list.add_child(_head_row("icons/" + str(DB.item(out).get("icon", out)), str(r.get("name", rid)),
		"%s · difficulty %d (%s) · %d operations" % [Crafting.DISCIPLINE_NAME.get(str(r.get("discipline", "")), ""), Crafting.difficulty(rid), Crafting.difficulty_word(rid),
			Crafting.operations(rid).size()], GuideUI.badge(str(rs["state"]), GuideUI.recipe_badge_text(rs), 30)))
	if str(r.get("desc", "")) != "":
		list.add_child(UIKit.rich("[i]%s[/i]" % str(r["desc"]), 20))
	# at a glance: needs, stations, what stands in the way
	var ins := []
	for k in r.get("inputs", {}):
		var need := int(r["inputs"][k])
		var have := Game.count(str(k))
		ins.append("%s %d× %s [color=#5e421c](have %d)[/color]" % [GuideUI.glyph("have" if have >= need else Guide.status(str(k), need)), need, GuideUI.item_link(str(k)), have])
	var sts := []
	for s in r.get("steps", []):
		var sl := "%s %s" % [GuideUI.glyph("ready" if Crafting.station_locked_reason(str(s)) == "" else "locked"), GuideUI.station_link(str(s))]
		if not sts.has(sl):
			sts.append(sl)
	list.add_child(GuideUI.rich_links("[b]Needs:[/b] %s\n[b]Stations:[/b] %s\n[b]Makes:[/b] %d× %s" % ["   ".join(ins), " → ".join(sts),
		int(r.get("qty", 1)), GuideUI.item_link(out)], 20, _on_meta))
	var blockers := []
	for o in rs["obstacles"]:
		if str(o["kind"]) == "input":
			continue
		var t := str(o["text"])
		if str(o["kind"]) == "node":
			t = GuideUI.link("skilltree:" + str(o["id"]), t)
		elif str(o["kind"]) == "station":
			t = GuideUI.link("station:" + str(o["id"]), t)
		blockers.append("%s %s" % [GuideUI.glyph("locked"), t])
	if not blockers.is_empty():
		list.add_child(GuideUI.rich_links("[b]In the way:[/b]\n" + "\n".join(blockers), 20, _on_meta))
	list.add_child(_heading("Show me how"))
	list.add_child(GuideUI.next_step_box("recipe:" + rid, _on_meta))
	list.add_child(GuideUI.expander("Full details: dependency tree, operations and alternatives", func(body: VBoxContainer):
		body.add_child(GuideUI.tree_block("recipe:" + rid, _on_meta))
		var ops := []
		var i := 1
		for o in Crafting.operations(rid):
			ops.append("%d. %s — %s (%d check%s)" % [i, str(o["op"]), Guide.sname(str(o["station"])), int(o.get("checks", 1)), "" if int(o.get("checks", 1)) == 1 else "s"])
			i += 1
		var dice := []
		for k in r.get("dice", {}):
			dice.append("%s %s" % [str(k).capitalize(), str(r["dice"][k])])
		body.add_child(UIKit.rich("[b]Operations[/b]\n%s\n[b]Dice:[/b] %s" % ["\n".join(ops), ", ".join(dice) if not dice.is_empty() else "none"], 18))
		for d in rs["missing"]:
			body.add_child(UIKit.label("Every way to get %s" % Guide.iname(str(d)), 21, "heading"))
			body.add_child(GuideUI.sources_block(str(d), _on_meta, 8))))


func _station_page(sid: String) -> void:
	var st := DB.station(sid)
	var why := Crafting.station_locked_reason(sid)
	list.add_child(_head_row("stations/" + sid, str(st.get("name", sid)), str(Crafting.DISCIPLINE_NAME.get(str(st.get("discipline", "")), "")),
		GuideUI.badge("ready" if why == "" else "locked", "In your workshop" if why == "" else "Not usable yet", 30)))
	list.add_child(UIKit.rich(str(st.get("purpose", "")), 20))
	var facts := []
	var ni := SkillTree.station_node(sid)
	if ni != "" and SkillTree.node_state(ni) != "hidden":
		facts.append("[b]Learned from:[/b] %s %s" % [GuideUI.glyph("ready" if SkillTree.is_unlocked(ni) else "locked"),
			GuideUI.link("skilltree:" + ni, "«%s» in the Skill Tree" % str(SkillTree.node(ni).get("name", ni)))])
	if not Property.is_installed(sid):
		facts.append("[b]Price:[/b] %d g — %s" % [Property.station_price(sid), GuideUI.link("route:property", "Property & Workshop › Equipment")])
	facts.append("[b]Your %s:[/b] level %d — a higher level widens the precision zone and slows the needle." % [SkillSys.skill_name(Crafting.skill_for_station(sid)),
		Game.player_level(Crafting.skill_for_station(sid))])
	list.add_child(GuideUI.rich_links("\n".join(facts), 20, _on_meta))
	if why != "":
		list.add_child(_heading("Show me how"))
		list.add_child(GuideUI.next_step_box("station:" + sid, _on_meta, {}, Guide.station_step(sid, why)))
	var rl := []
	for r in Crafting.recipes_for_station(sid):
		if Reference.recipe_visible(str(r["id"])):
			rl.append("%s %s" % [GuideUI.glyph(str(Guide.recipe_status(str(r["id"]))["state"])), GuideUI.recipe_link(str(r["id"]))])
	list.add_child(_heading("Designs the workshop knows that use it (%d)" % rl.size()))
	list.add_child(GuideUI.rich_links("   ".join(rl) if not rl.is_empty() else "[i]None yet — the Skill Tree teaches the workshop new Designs.[/i]", 19, _on_meta))
